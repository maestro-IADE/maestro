{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maestro",
  "version": "0.3.3",
  "identifier": "dev.maestro.app",
  "build": {
    "beforeDevCommand": "cargo build --manifest-path src-tauri/Cargo.toml --bin maestro-cli && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Maestro", "width": 1360, "height": 820, "center": true, "dragDropEnabled": false, "decorations": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5NjA2Mzc5NEYzREVGODEKUldTQjd6MVBlV05nZWRDdEwvUnAzbEY4MHlXZ1dsenZYbDlnV3E4K1pOSDNLZUhuTW5oVHdlTHYK",
      "endpoints": ["https://github.com/maestro-IADE/maestro/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
